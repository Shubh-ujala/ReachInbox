# ─── Server Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=3001
NODE_ENV=development

# Redis
# Preferred: full URL (works for local and cloud providers like Upstash)
REDIS_URL=redis://localhost:6379
# Fallback individual settings (used when REDIS_URL is not set)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to true for TLS-enabled providers (Upstash, Redis Cloud, etc.)
REDIS_TLS=false

# Gmail or Ethereal SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="ReachInbox Scheduler <your_email@gmail.com>"

# CORS — set to your frontend origin
FRONTEND_URL=http://localhost:5173

# BullMQ Worker tuning
WORKER_CONCURRENCY=5
JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY=5000

# ─── MongoDB Atlas Database ──────────────────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/reachinbox?retryWrites=true&w=majority
MONGODB_URI=

# ─── Clerk Authentication ────────────────────────────────────────────────────
# Obtain keys from your Clerk Dashboard -> API Keys (https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

JWT_SECRET=reachinbox-jwt-secret-key-super-secure-32chars!
JWT_EXPIRES_IN=7d
